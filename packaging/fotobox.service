# Fotobox als systemd-Benutzerdienst.
#
# Der Dienst wird nicht beim Hochfahren gestartet, sondern von der
# Autostart-Datei der Desktop-Sitzung. Erst dort stehen die Variablen zur
# Verfuegung, ohne die Qt keine Anzeige findet.
#
#   cp /usr/share/fotobox/fotobox-autostart.desktop ~/.config/autostart/
#
# Von Hand steuern:
#   systemctl --user status fotobox
#   systemctl --user restart fotobox
#   journalctl --user -u fotobox -f

[Unit]
Description=Fotobox
Documentation=https://github.com/bene726/Fotobox_qt6
After=graphical-session.target
PartOf=graphical-session.target
# Nicht endlos neu starten, wenn grundsaetzlich etwas fehlt
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/fotobox
Restart=on-failure
RestartSec=5
# Die Anwendung meldet sich aus ihrem Eventloop. Bleibt die Meldung aus, haengt
# der Eventloop: der Prozess lebt dann noch, zeigt aber ein eingefrorenes Bild.
# Ohne diesen Eintrag faellt das dem Dienst nicht auf, denn ein Einfrieren ist
# kein Absturz. systemd beendet den Dienst dann mit SIGABRT, was als Fehlschlag
# zaehlt und ueber Restart=on-failure zum Neustart fuehrt.
#
# 30 s sind reichlich fuer den Start samt Kamera; die Anwendung meldet sich
# alle 10 s. Der Wert steht der Anwendung in WATCHDOG_USEC zur Verfuegung, sie
# richtet ihren Takt danach.
WatchdogSec=30

[Install]
WantedBy=graphical-session.target
